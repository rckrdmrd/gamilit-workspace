    "vistas": [
      {
        "nombre": "v_student_module_progress",
        "schema": "public",
        "descripcion": "Vista de progreso detallado de estudiantes en módulos",
        "historia_origen": "US-FUND-003",
        "criticidad": "P2",
        "columnas_visibles": [
          "student_id",
          "student_name",
          "module_id",
          "module_title",
          "completed_activities",
          "total_activities",
          "progress_percentage",
          "started_at",
          "completed_at"
        ],
        "query": "SELECT u.id, CONCAT(u.firstName, ' ', u.lastName) as student_name, m.id, m.title, sp.completedActivities, sp.totalActivities, sp.progressPercentage, sp.startedAt, sp.completedAt FROM student_progress sp JOIN users u ON u.id = sp.studentId JOIN modules m ON m.id = sp.moduleId"
      },
      {
        "nombre": "v_student_leaderboard",
        "schema": "public",
        "descripcion": "Vista para leaderboard de estudiantes por XP y nivel",
        "historia_origen": "US-FUND-003",
        "criticidad": "P2",
        "columnas_visibles": [
          "rank",
          "student_id",
          "student_name",
          "level",
          "total_xp",
          "coins",
          "rank_name",
          "activities_completed"
        ],
        "query": "SELECT ROW_NUMBER() OVER (ORDER BY ss.totalXP DESC) as rank, ss.studentId, CONCAT(u.firstName, ' ', u.lastName) as student_name, ss.currentLevel, ss.totalXP, ss.coins, ss.rankName, ss.activitiesCompleted FROM student_stats ss JOIN users u ON u.id = ss.studentId WHERE u.role = 'student' ORDER BY ss.totalXP DESC"
      },
      {
        "nombre": "v_pending_activities",
        "schema": "public",
        "descripcion": "Vista de actividades pendientes para estudiantes",
        "historia_origen": "US-FUND-003",
        "criticidad": "P1",
        "columnas_visibles": [
          "student_id",
          "activity_id",
          "activity_title",
          "module_id",
          "module_title",
          "activity_type",
          "estimated_time",
          "xp_reward",
          "coins_reward"
        ],
        "query": "SELECT sp.studentId, a.id, a.title, a.moduleId, m.title, a.type, a.estimatedTime, a.xpReward, a.coinsReward FROM student_progress sp JOIN modules m ON m.id = sp.moduleId JOIN activities a ON a.moduleId = m.id LEFT JOIN activity_completions ac ON ac.activityId = a.id AND ac.studentId = sp.studentId WHERE sp.studentId = ? AND sp.completedAt IS NULL AND ac.id IS NULL"
      }
    ],
