# ============================================================================
# GAMILIT Backend - Development Environment Variables (EXAMPLE)
# ============================================================================
# INSTRUCCIONES:
# 1. Copiar este archivo a .env (para desarrollo local)
#    O a .env.dev (para desarrollo con WSL2 PostgreSQL)
# 2. Reemplazar los valores <...> con valores de tu entorno
# 3. NUNCA commitear este archivo con credenciales reales
#
# ORDEN DE CARGA (.env priority):
# 1. .env.local      (local overrides, NEVER committed)
# 2. .env.dev        (dev on Windows+WSL2 with PostgreSQL in WSL)
# 3. .env            (fallback, tracked in git with defaults)
#
# Ver: apps/backend/src/app.module.ts L55-59 para ConfigModule.envFilePath
# ============================================================================

# ==================== SERVER ====================
# Puerto del backend API
NODE_ENV=development
PORT=3006
API_PREFIX=api

# Nombre y versión de la aplicación
APP_NAME=GAMILIT
APP_VERSION=4.1.0

# ==================== DATABASE ====================
# Configuración de PostgreSQL 15
# IMPORTANTE: DB_USERNAME es leído por database.config.ts (TypeORM).
#             DB_USER es usado por scripts de database (DDL, seeds, etc.).
#             Ambos deben tener el MISMO valor.
#             DB_DATABASE es la variable principal para el nombre de la BD.
#
# Por defecto, usa 127.0.0.1 en Windows.
# Con WSL2: ejecutar "npm run predev" para auto-detectar IP de WSL
# O configurar manualmente DB_HOST a tu IP de WSL (ej: 172.21.220.31)
#
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=gamilit_platform
DB_USER=gamilit_user
DB_USERNAME=gamilit_user
DB_PASSWORD=gamilit_dev_2026
DB_SYNCHRONIZE=false
DB_LOGGING=false

# Pool de conexiones (2 por datasource × 11 datasources = 22 conexiones máx)
DB_POOL_MAX=2
DB_CONNECTION_TIMEOUT=15000
DB_IDLE_TIMEOUT=30000

# Retry strategy
DB_RETRY_ATTEMPTS=5
DB_RETRY_DELAY=5000

# Modo de host (solo para desarrollo con WSL2)
# Valores: auto | localhost | wsl-ip
# - auto: intenta WSL2 IP, fallback a localhost
# - localhost: fuerza 127.0.0.1 (puede causar ECONNRESET con 11 datasources)
# - wsl-ip: requiere IP de WSL (falla si no está disponible)
DB_HOST_MODE=auto
# WSL_DISTRO=Ubuntu-24.04   # Descomentar si tienes múltiples distros

# SSL para conexión a BD (desarrollo: false, producción: puede ser true)
DB_SSL=false

# ==================== JWT (JSON Web Tokens) ====================
# IMPORTANTE: NUNCA usar valores de ejemplo en producción
# Generar secret con: openssl rand -base64 32
# O: npx @nestjs/cli generate-secret
#
JWT_SECRET=dev-only-jwt-secret-not-for-production-min-32-chars-required
JWT_EXPIRES_IN=24h
JWT_REFRESH_SECRET=dev-only-refresh-secret-not-for-production-min-32-chars
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=gamilit-api
JWT_AUDIENCE=gamilit-app

# ==================== SESSION ====================
# IMPORTANTE: Generar secret único en producción con: openssl rand -base64 32
SESSION_SECRET=dev-only-session-secret-not-for-production-min-32-chars
SESSION_MAX_AGE=86400000

# ==================== CORS (Cross-Origin Resource Sharing) ====================
# CRÍTICO: Configurar orígenes permitidos correctamente
# Desarrollo: http://localhost:3005 (frontend React)
# Producción: https://74.208.126.102:3005 (con SSL)
#
# ============================================================================
# ADVERTENCIA: HEADERS CORS DUPLICADOS
# ============================================================================
# Si usas Nginx como proxy SSL, NO agregar headers CORS en Nginx.
# NestJS maneja CORS internamente en main.ts.
# Headers duplicados causan error:
#   "The 'Access-Control-Allow-Origin' header contains multiple values"
#
# SOLUCION: Solo NestJS maneja CORS, Nginx solo hace proxy sin headers CORS.
# ============================================================================
#
CORS_ORIGIN=http://localhost:3005,http://localhost:3006
ENABLE_CORS=true
ALLOWED_ORIGINS=http://localhost:3005,http://localhost:3006

# ==================== SWAGGER & API DOCUMENTATION ====================
# Swagger: http://localhost:3006/api-docs
# Deshabilitado automáticamente en producción
ENABLE_SWAGGER=true

# ==================== LOGGING ====================
LOG_LEVEL=debug
LOG_TO_FILE=false
# ENABLE_TRACING=true    # Descomentar para OpenTelemetry tracing (opcional)

# ==================== RATE LIMITING ====================
# Limitar rate de requests para prevenir abuse
# TTL: segundos, MAX: número de requests permitidos en ese período
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# ==================== PAGINATION ====================
# Defaults para listados paginados
PAGINATION_DEFAULT_LIMIT=20
PAGINATION_MAX_LIMIT=100

# ==================== FILE UPLOADS ====================
# Límite de tamaño de archivo (5 MB por defecto)
MAX_FILE_SIZE=5242880
UPLOAD_DESTINATION=./uploads
ALLOWED_MIME_TYPES=image/jpeg,image/png,image/gif,application/pdf

# ==================== EMAIL ====================
# Configurar credenciales si se envían emails (SMTP)
# Transportes soportados: nodemailer, sendgrid, mailgun, resend
EMAIL_FROM=noreply@gamilit.com
EMAIL_REPLY_TO=support@gamilit.com

# Ejemplo SMTP (descomentar y configurar):
# EMAIL_TRANSPORT=smtp
# SMTP_HOST=mail.example.com
# SMTP_PORT=587
# SMTP_USER=user@example.com
# SMTP_PASSWORD=your-password
# SMTP_SECURE=true

# ==================== FRONTEND URL ====================
# URL del frontend para redirects, password reset links, etc.
# Desarrollo: http://localhost:3005
# Producción: https://74.208.126.102:3005
FRONTEND_URL=http://localhost:3005

# ==================== WEB PUSH NOTIFICATIONS (VAPID) ====================
# Web Push API nativo para push notifications en navegadores
# IMPORTANTE: Generar claves VAPID SOLO para producción:
#   npx web-push generate-vapid-keys
#
# VAPID (Voluntary Application Server Identification):
# - Public Key: Se comparte con el frontend para crear subscripciones
# - Private Key: Se mantiene secreta en backend para firmar notificaciones
# - Subject: Email de contacto o URL del sitio (mailto: o https:)
#
# Compatible con: Chrome, Firefox, Edge, Safari 16.4+
# NOTA: En desarrollo, push notifications no son críticas.
#       En producción, generar claves reales.
#
VAPID_PUBLIC_KEY=dev-placeholder-public-key
VAPID_PRIVATE_KEY=dev-placeholder-private-key
VAPID_SUBJECT=mailto:admin@gamilit.com

# ==================== SMS NOTIFICATIONS (TWILIO) ====================
# Twilio SMS API para envío de notificaciones por SMS (opcional)
# IMPORTANTE: Las credenciales se obtienen desde https://www.twilio.com
#
# En desarrollo, estas variables pueden estar vacías (graceful degradation).
# SMS se deshabilitará silenciosamente si no están configuradas.
#
TWILIO_ACCOUNT_SID=dev-placeholder
TWILIO_AUTH_TOKEN=dev-placeholder
TWILIO_PHONE_NUMBER=+1234567890

# ==================== REDIS (Socket.IO & Message Persistence) ====================
# Redis configuration para Socket.IO (websockets) e offline message storage
# IMPORTANTE: En desarrollo en Windows, REDIS_ENABLED=false para evitar problemas
#             con el proxy svchost.exe de Windows.
#
# Si Redis no está configurado o disponible:
# - Socket.IO caerá a adapter en-memoria (sin horizontal scaling)
# - Offline message persistence será deshabilitada
#
# Para alta disponibilidad en producción:
# REDIS_URL=redis://sentinel1:26379,sentinel2:26379,sentinel3:26379?sentinelMasterName=mymaster
#
REDIS_ENABLED=false
REDIS_URL=redis://127.0.0.1:6379
REDIS_PASSWORD=
REDIS_SOCKET_DB=0
REDIS_SOCKET_PREFIX=gamilit:socket:
REDIS_MESSAGE_PREFIX=gamilit:pending:
REDIS_MESSAGE_TTL=86400
REDIS_MAX_PENDING_MESSAGES=100
REDIS_RETRY_DELAY_MS=1000
REDIS_MAX_RETRIES=5

# ==================== CRON JOBS ====================
# Ejecutar trabajos programados (background tasks, cleanup, reports, etc.)
# En desarrollo: false (evita saturar pool de BD con 19 cron jobs)
# En producción: true
CRON_ENABLED=false

# ==================== DATA WAREHOUSE (ETL, ML, Visualization) ====================
# Habilita módulos ETL, ML predictions, y Visualization.
# IMPORTANTE: Requiere que el schema data_warehouse esté provisionado en PostgreSQL.
# Default: false (deshabilitado)
#
# ETL: Extract-Transform-Load pipeline para analytics
# ML: Machine Learning predictions sobre progress y gamificación
# Visualization: Dashboards y reportes
#
# Para habilitar:
# 1. Crear schema data_warehouse en PostgreSQL (ver DDL)
# 2. Configurar ENABLE_DATA_WAREHOUSE=true
# 3. Reiniciar backend
#
ENABLE_DATA_WAREHOUSE=false

# ==================== MANTENIMIENTO ====================
# Modo de mantenimiento (desabilita la mayoría de endpoints)
MAINTENANCE_MODE=false

# ==================== TESTING (desarrollo) ====================
# Flags para testing en desarrollo
# ENABLE_SEED_DATA=true        # Descomentar para cargar seeds automáticamente
# MOCK_EXTERNAL_SERVICES=true  # Descomentar para mockear servicios externos
# E2E_TEST_MODE=false          # Descomentar solo para tests E2E

# ============================================================================
# NOTAS DE SEGURIDAD
# ============================================================================
#
# 1. DESARROLLO:
#    - .env.example está commiteado con valores de ejemplo
#    - .env.local está en .gitignore (local overrides con credenciales reales)
#    - npm install auto-genera .env si no existe
#
# 2. PRODUCCIÓN:
#    - JWT_SECRET: DEBE ser diferente, usar 32+ caracteres aleatorios
#    - DB_PASSWORD: NUNCA commitear credenciales reales
#    - SESSION_SECRET: Generar valor único y seguro
#    - CORS_ORIGIN: Solo incluir orígenes confiables, NUNCA usar "*"
#    - ENABLE_SWAGGER: DEBE estar en false en producción
#    - Permisos archivo: chmod 600 .env.production (solo owner puede leer)
#    - Logs: Verificar que LOG_TO_FILE no exponga datos sensibles
#
# 3. VARIABLES NO COMMITEADAS:
#    - Credenciales sensibles deben estar en .env.local o .env.production
#    - Ambos archivos están en .gitignore
#
# ============================================================================
# VALIDACIÓN PRE-DEPLOY
# ============================================================================
#
# Antes de cada deployment, verificar:
#
# [ ] DATABASE:
#     [ ] DB_HOST resuelve (WSL2 IP en dev, servidor en prod)
#     [ ] DB_DATABASE es 'gamilit_platform'
#     [ ] DB_USER y DB_USERNAME coinciden
#     [ ] DB_PASSWORD está configurado
#     [ ] npm run db:test conecta exitosamente
#
# [ ] JWT:
#     [ ] JWT_SECRET != "dev-only-jwt-secret-..." en producción
#     [ ] JWT_SECRET tiene 32+ caracteres
#     [ ] JWT_REFRESH_SECRET también cambiado en producción
#
# [ ] CORS:
#     [ ] CORS_ORIGIN incluye origen del frontend correcto
#     [ ] CORS_ORIGIN NO contiene "*" (wildcard inseguro)
#
# [ ] EMAIL:
#     [ ] EMAIL_FROM es dominio válido
#     [ ] SMTP configurado si se requieren emails
#     [ ] VAPID_* configurado si se requieren push notifications
#
# [ ] REDIS:
#     [ ] REDIS_ENABLED=true en producción + Sentinel/Cluster
#     [ ] REDIS_ENABLED=false en desarrollo (Windows)
#
# [ ] SEGURIDAD:
#     [ ] ENABLE_SWAGGER=false en producción
#     [ ] LOG_LEVEL=warn en producción (no 'debug')
#     [ ] MAINTENANCE_MODE=false
#
# ============================================================================
# COMANDOS ÚTILES
# ============================================================================
#
# Detectar WSL2 IP automáticamente (Windows + WSL2):
#   npm run predev
#
# Validar conectividad a BD:
#   npm run db:test
#
# Recrear BD desde DDL:
#   bash apps/database/scripts/recreate-database.sh
#
# Ejecutar seeds:
#   npm run db:seed
#
# ============================================================================
