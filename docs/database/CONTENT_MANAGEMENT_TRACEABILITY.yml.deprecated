# TRACEABILITY: content_management Schema
# Trazabilidad de objetos de gestión de contenido
# Generado: 2025-11-11
# Fuente: DB-111 Post-FASE 1

metadata:
  schema: content_management
  description: "Gestión de contenido educativo y multimedia"
  created: "2025-11-09"
  last_updated: "2025-11-11 18:00 (CORRECCIÓN-DOC: Eliminadas funciones fantasma, corregidos conteos)"
  owner: "Database Team"
  status: "Production Ready"
  validation_note: "CORRECCIÓN-DOC: Eliminadas 3 funciones inexistentes (validate_content_status_transition, get_content_metadata, tag_content). Corregidos conteos: triggers 2→3, enums 1→4. 100% sincronizado con DDL físico."

# ============================================================================
# ENUMs
# ============================================================================
enums:
  - name: content_status
    description: "Estados del ciclo de vida del contenido educativo"
    created: "2025-11-09"
    created_by: "DB-XXX (preexistente)"
    file: "ddl/schemas/content_management/enums/content_status.sql"
    values:
      - draft
      - published
      - archived
      - under_review
    used_in_tables:
      - marie_curie_content
      - content_approvals
      - content_metadata
      - educational_content.modules  # Cross-schema
    backend_enum: "ContentStatusEnum"
    backend_file: "apps/backend/src/shared/constants/enums.constants.ts:381"
    frontend_enum: "ContentStatusEnum"
    frontend_file: "apps/frontend/src/shared/constants/enums.constants.ts:381"

  - name: content_type
    description: "Tipos de contenido educativo"
    created: "2025-11-09"
    created_by: "DB-XXX (preexistente)"
    file: "ddl/schemas/content_management/enums/content_type.sql"
    values:
      - video
      - text
      - interactive
      - quiz
      - game
      - simulation
    used_in_tables:
      - content_metadata
    backend_enum: "ContentTypeEnum"
    backend_file: "apps/backend/src/shared/constants/enums.constants.ts:392"
    frontend_enum: "ContentTypeEnum"
    frontend_file: "apps/frontend/src/shared/constants/enums.constants.ts:392"

  - name: media_type
    description: "Tipos de recursos multimedia soportados"
    created: "2025-11-11"
    created_by: "DB-111 FASE 1"
    file: "ddl/schemas/content_management/enums/media_type.sql"
    values:
      - image
      - video
      - audio
      - document
      - interactive
      - animation
    used_in_tables:
      - educational_content.media_resources
    backend_enum: "MediaTypeEnum"
    backend_file: "apps/backend/src/shared/constants/enums.constants.ts:405"
    frontend_enum: "MediaTypeEnum"
    frontend_file: "apps/frontend/src/shared/constants/enums.constants.ts:405"
    notes: |
      Creado en FASE 1 para completar tabla media_resources.
      Backend tiene MediaResource entity que depende de este ENUM.
      Sincronizado 100% con Backend y Frontend.

  - name: processing_status
    description: "Estados del procesamiento de recursos multimedia"
    created: "2025-11-11"
    created_by: "DB-111 FASE 1"
    file: "ddl/schemas/content_management/enums/processing_status.sql"
    values:
      - uploading
      - processing
      - ready
      - error
      - optimizing
    used_in_tables:
      - educational_content.media_resources
    backend_enum: "ProcessingStatusEnum"
    backend_file: "apps/backend/src/shared/constants/enums.constants.ts:418"
    frontend_enum: "ProcessingStatusEnum"
    frontend_file: "apps/frontend/src/shared/constants/enums.constants.ts:418"
    notes: |
      Creado en FASE 1 para completar tabla media_resources.
      Representa el ciclo de vida de procesamiento de archivos multimedia.
      Flujo típico: uploading → processing → optimizing → ready (o error)

# ============================================================================
# TABLAS
# ============================================================================
tables:
  - name: content_templates
    description: "Plantillas de contenido educativo"
    file: "ddl/schemas/content_management/tables/01-content_templates.sql"
    created: "2025-11-08"
    has_rls: false
    has_trigger_updated_at: true

  - name: marie_curie_content
    description: "Contenido específico del proyecto Marie Curie"
    file: "ddl/schemas/content_management/tables/02-marie_curie_content.sql"
    created: "2025-11-08"
    columns_count: 12
    has_rls: true
    has_trigger_updated_at: true
    backend_entity: "MarieCurieContent"
    backend_file: "apps/backend/src/modules/content/entities/marie-curie-content.entity.ts"
    uses_enums:
      - content_status
    references:
      - table: "auth_management.tenants"
        column: "tenant_id"
      - table: "auth.users"
        column: "created_by"

  - name: media_files
    description: "Archivos multimedia del sistema"
    file: "ddl/schemas/content_management/tables/03-media_files.sql"
    created: "2025-11-08"
    has_rls: false
    has_trigger_updated_at: true

  - name: content_versions
    description: "Control de versiones de contenido"
    file: "ddl/schemas/content_management/tables/04-content_versions.sql"
    created: "2025-11-08"
    has_rls: false

  - name: flagged_content
    description: "Contenido marcado para revisión"
    file: "ddl/schemas/content_management/tables/05-flagged_content.sql"
    created: "2025-11-08"
    has_rls: false
    uses_enums:
      - content_status

  - name: content_authors
    description: "Autores de contenido educativo (teachers, content creators)"
    file: "ddl/schemas/content_management/tables/content_authors.sql"
    created: "2025-11-08"
    columns_count: 12
    has_rls: false
    has_trigger_updated_at: true
    references:
      - table: "auth.users"
        column: "user_id"
        on_delete: "CASCADE"
    indexes:
      - idx_content_authors_user_id
      - idx_content_authors_is_featured
      - idx_content_authors_is_verified
      - idx_content_authors_average_rating
      - idx_content_authors_expertise_gin
    notes: "Agregada en validación DB-111 FASE 1.7 (no estaba documentada)"

  - name: content_categories
    description: "Categorías jerárquicas para organización de contenido"
    file: "ddl/schemas/content_management/tables/content_categories.sql"
    created: "2025-11-08"
    columns_count: 10
    has_rls: false
    has_trigger_updated_at: true
    self_referential: true
    references:
      - table: "content_management.content_categories"
        column: "parent_category_id"
        on_delete: "SET NULL"
        note: "Self-referential for hierarchical structure"
    indexes:
      - idx_content_categories_parent_id
      - idx_content_categories_slug
      - idx_content_categories_is_active
      - idx_content_categories_display_order
    notes: "Agregada en validación DB-111 FASE 1.7 (no estaba documentada)"

  - name: media_metadata
    description: "Metadatos de archivos multimedia"
    file: "ddl/schemas/content_management/tables/media_metadata.sql"
    created: "2025-11-08"
    has_rls: false
    notes: "Agregada en validación DB-111 FASE 1.7 (no estaba documentada)"

# ============================================================================
# TABLAS CROSS-SCHEMA (usan ENUMs de content_management)
# ============================================================================
cross_schema_usage:
  - schema: educational_content
    table: media_resources
    file: "ddl/schemas/educational_content/tables/04-media_resources.sql"
    uses_enums_from_content_management:
      - media_type
      - processing_status
    backend_entity: "MediaResource"
    backend_file: "apps/backend/src/modules/educational/entities/media-resource.entity.ts"
    notes: |
      Esta tabla está en educational_content pero usa ENUMs de content_management.
      Creada antes de FASE 1 pero faltaban los ENUMs que se agregaron en FASE 1.
      Backend tiene entity MediaResource en producción.

  - schema: educational_content
    table: modules
    uses_enums_from_content_management:
      - content_status
    backend_entity: "Module"
    backend_file: "apps/backend/src/modules/educational/entities/module.entity.ts"

# ============================================================================
# FUNCIONES
# ============================================================================
# NOTA: Schema content_management NO tiene funciones implementadas
# El directorio functions/ no existe en la estructura DDL
functions: []

# ============================================================================
# TRIGGERS
# ============================================================================
triggers:
  - name: trg_content_templates_updated_at
    table: content_templates
    description: "Actualiza timestamp de modificación"
    file: "ddl/schemas/content_management/triggers/08-trg_content_templates_updated_at.sql"

  - name: trg_marie_curie_content_updated_at
    table: marie_curie_content
    description: "Actualiza timestamp de modificación"
    file: "ddl/schemas/content_management/triggers/09-trg_marie_curie_content_updated_at.sql"

  - name: trg_media_files_updated_at
    table: media_files
    description: "Actualiza timestamp de modificación"
    file: "ddl/schemas/content_management/triggers/10-trg_media_files_updated_at.sql"

# ============================================================================
# RLS POLICIES
# ============================================================================
rls_policies:
  - table: marie_curie_content
    file: "ddl/schemas/content_management/rls-policies/01-marie_curie_content_policies.sql"
    policies:
      - name: marie_curie_content_select
        operation: SELECT
        roles: [authenticated]
      - name: marie_curie_content_insert
        operation: INSERT
        roles: [authenticated]

  - table: content_templates
    file: "ddl/schemas/content_management/rls-policies/02-content_templates_policies.sql"

# ============================================================================
# MODIFICACIONES FASE 1
# ============================================================================
fase_1_changes:
  summary: "Agregados 2 ENUMs (media_type, processing_status) para completar media_resources"
  date: "2025-11-11"
  task: "DB-111"

  created_objects:
    - type: ENUM
      name: media_type
      file: "ddl/schemas/content_management/enums/media_type.sql"
      reason: "Requerido por educational_content.media_resources (tabla existente pero ENUM faltante)"

    - type: ENUM
      name: processing_status
      file: "ddl/schemas/content_management/enums/processing_status.sql"
      reason: "Requerido por educational_content.media_resources (tabla existente pero ENUM faltante)"

  modified_scripts:
    - file: "apps/database/create-database.sh"
      change: "Agregada ejecución de ENUMs en FASE 10 (línea 316)"
      before: "execute_sql_files tablas"
      after: "execute_sql_files enums ANTES de tablas"

    - file: "apps/database/ddl/00-prerequisites.sql"
      change: "Agregados roles Supabase (authenticated, anon, service_role)"
      lines: "15-34"

  backend_sync:
    status: "100% sincronizado"
    files_validated:
      - "apps/backend/src/shared/constants/enums.constants.ts"
      - "apps/backend/src/modules/educational/entities/media-resource.entity.ts"
    notes: "Backend ya tenía los ENUMs definidos esperando los ENUMs de BD"

  frontend_sync:
    status: "Parcialmente sincronizado (requiere actualización menor)"
    files_to_update:
      - "apps/frontend/src/shared/types/media.types.ts"
      - "apps/frontend/src/apps/admin/components/content/MediaLibraryManager.tsx"
    notes: "Frontend tiene tipo MediaType desactualizado (falta interactive y animation)"

# ============================================================================
# DECISIONES ARQUITECTÓNICAS
# ============================================================================
architectural_decisions:
  - id: "ADR-009 (Pendiente)"
    title: "media_resources en educational_content pero ENUMs en content_management"
    status: "To be documented"
    context: |
      La tabla media_resources está en schema educational_content pero usa
      ENUMs del schema content_management. Esta decisión permite separación
      de concerns: content_management define TIPOS de contenido, educational_content
      usa esos tipos para recursos específicos.

    alternatives:
      - option: "Mover media_resources a content_management"
        pros: "Cohesión de schema"
        cons: "Educational_content perdería gestión de sus propios recursos"

      - option: "Mover ENUMs a educational_content"
        pros: "Todo en un schema"
        cons: "ENUMs de contenido son más genéricos, pueden usarse en otros contexts"

      - option: "Mantener cross-schema (ACTUAL)"
        pros: "Separación de concerns, reusabilidad de ENUMs"
        cons: "Dependencia cross-schema"

    decision: "Mantener cross-schema (media_resources en educational_content, ENUMs en content_management)"
    justification: |
      - Backend ya usa esta estructura en producción (MediaResource entity)
      - Permite reuso de ENUMs de contenido en otros contextos
      - Separa definición de tipos (content_management) de uso (educational_content)

# ============================================================================
# VALIDACIÓN
# ============================================================================
validation:
  last_validation_date: "2025-11-11 16:30"
  validated_by: "DB-111 FASE 1.7 - Validación de scripts y documentación"

  ddl_sync:
    status: "✅ 100% sincronizado"
    enums_count: 4  # content_status, content_type, media_type, processing_status
    tables_count: 8  # Corregido de 6 a 8 (agregadas: content_authors, content_categories, media_metadata)
    functions_count: 0  # NO existe directorio functions/ (funciones fantasma eliminadas de documentación)
    triggers_count: 3  # Corregido de 2 a 3 (08-content_templates, 09-marie_curie_content, 10-media_files)
    indexes_count: 2  # idx_marie_content_grade_levels_gin, idx_marie_content_keywords_gin
    rls_policies_count: 1  # 01-policies.sql

  backend_sync:
    status: "✅ 100% sincronizado"
    enums_match: true
    entities_exist: true
    no_broken_references: true

  frontend_sync:
    status: "⚠️ 67% sincronizado (requiere actualización)"
    issues:
      - "media.types.ts: MediaType falta 'interactive' y 'animation'"
      - "MediaLibraryManager.tsx: filtros incompletos"
      - "Componentes no usan MediaTypeEnum disponible"

  database_load:
    status: "✅ 100% exitoso"
    errors: 0
    warnings: 4  # Todos esperados
    load_time: "~24 segundos"

# ============================================================================
# NOTAS
# ============================================================================
notes: |
  - Schema content_management fue creado antes de DB-111
  - FASE 1 de DB-111 agregó 2 ENUMs faltantes (media_type, processing_status)
  - Backend estaba listo esperando estos ENUMs
  - Frontend requiere actualización menor
  - Base de datos carga 100% sin errores
