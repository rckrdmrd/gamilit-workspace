  "vistas": [
    {
      "id": "VW-001",
      "nombre": "vw_leaderboard_global",
      "descripcion": "Vista del leaderboard global ordenado por XP total. Retorna top 10 usuarios",
      "epica_origen": "EAI-003",
      "user_story": "US-GAM-007",
      "prioridad": "P1",
      "sql_definicion": "CREATE VIEW vw_leaderboard_global AS\nSELECT \n  ROW_NUMBER() OVER (ORDER BY u.total_xp DESC) as position,\n  u.id,\n  CONCAT(u.first_name, ' ', u.last_name) as name,\n  u.total_xp,\n  u.current_rank,\n  u.level,\n  u.photo_url\nFROM users u\nWHERE u.deleted_at IS NULL\nORDER BY u.total_xp DESC\nLIMIT 10;",
      "columnas_resultado": [
        {"nombre": "position", "tipo": "INTEGER"},
        {"nombre": "id", "tipo": "UUID"},
        {"nombre": "name", "tipo": "VARCHAR"},
        {"nombre": "total_xp", "tipo": "INTEGER"},
        {"nombre": "current_rank", "tipo": "VARCHAR"},
        {"nombre": "level", "tipo": "INTEGER"},
        {"nombre": "photo_url", "tipo": "VARCHAR"}
      ]
    },
    {
      "id": "VW-002",
      "nombre": "vw_user_gamification_summary",
      "descripcion": "Vista consolidada del estado gamificado de un usuario. Combina XP, rango, monedas, insignias y módulos",
      "epica_origen": "EAI-003",
      "user_story": "Múltiples",
      "prioridad": "P1",
      "sql_definicion": "CREATE VIEW vw_user_gamification_summary AS\nSELECT \n  u.id,\n  u.total_xp,\n  u.current_rank,\n  u.level,\n  u.total_coins,\n  COUNT(DISTINCT ub.badge_id) as badges_earned,\n  COUNT(DISTINCT mc.module_id) as modules_completed,\n  (SELECT COUNT(*) FROM rank_history rh WHERE rh.user_id = u.id) as ranks_achieved\nFROM users u\nLEFT JOIN user_badges ub ON u.id = ub.user_id\nLEFT JOIN module_completion mc ON u.id = mc.user_id\nGROUP BY u.id;",
      "columnas_resultado": [
        {"nombre": "id", "tipo": "UUID"},
        {"nombre": "total_xp", "tipo": "INTEGER"},
        {"nombre": "current_rank", "tipo": "VARCHAR"},
        {"nombre": "level", "tipo": "INTEGER"},
        {"nombre": "total_coins", "tipo": "INTEGER"},
        {"nombre": "badges_earned", "tipo": "BIGINT"},
        {"nombre": "modules_completed", "tipo": "BIGINT"},
        {"nombre": "ranks_achieved", "tipo": "BIGINT"}
      ]
    }
  ],
  "funciones": [
    {
      "id": "FN-001",
      "nombre": "fn_calculate_rank_from_xp",
      "descripcion": "Función que calcula el rango actual basado en XP total. Retorna el enum de rango correspondiente",
      "epica_origen": "EAI-003",
      "user_story": "US-GAM-001",
      "prioridad": "P0",
      "parametros": [
        {"nombre": "p_total_xp", "tipo": "INTEGER", "descripcion": "XP total del usuario"}
      ],
      "retorna": "VARCHAR(50)",
      "logica": "Retorna: 'novato' si 0-99, 'aprendiz' si 100-499, 'explorador' si 500-1499, 'maestro' si 1500-3999, 'sabio' si 4000+",
      "sql": "CREATE FUNCTION fn_calculate_rank_from_xp(p_total_xp INTEGER) RETURNS VARCHAR(50) AS $$\nBEGIN\n  RETURN CASE \n    WHEN p_total_xp < 100 THEN 'novato'\n    WHEN p_total_xp < 500 THEN 'aprendiz'\n    WHEN p_total_xp < 1500 THEN 'explorador'\n    WHEN p_total_xp < 4000 THEN 'maestro'\n    ELSE 'sabio'\n  END;\nEND;\n$$ LANGUAGE plpgsql IMMUTABLE;"
    },
    {
      "id": "FN-002",
      "nombre": "fn_calculate_level_from_xp",
      "descripcion": "Función que calcula el nivel numérico (1-100) basado en XP. Fórmula: floor(XP/100) + 1",
      "epica_origen": "EAI-003",
      "user_story": "US-GAM-001",
      "prioridad": "P0",
      "parametros": [
        {"nombre": "p_total_xp", "tipo": "INTEGER", "descripcion": "XP total del usuario"}
      ],
      "retorna": "INTEGER",
      "logica": "Retorna: (floor(XP / 100) + 1), mínimo 1, máximo 100",
      "sql": "CREATE FUNCTION fn_calculate_level_from_xp(p_total_xp INTEGER) RETURNS INTEGER AS $$\nBEGIN\n  RETURN LEAST(GREATEST(FLOOR(p_total_xp::FLOAT / 100) + 1, 1), 100);\nEND;\n$$ LANGUAGE plpgsql IMMUTABLE;"
    },
    {
      "id": "FN-003",
      "nombre": "fn_get_user_position_in_leaderboard",
      "descripcion": "Función que retorna la posición de un usuario en el leaderboard global por XP",
      "epica_origen": "EAI-003",
      "user_story": "US-GAM-007",
      "prioridad": "P1",
      "parametros": [
        {"nombre": "p_user_id", "tipo": "UUID", "descripcion": "ID del usuario"}
      ],
      "retorna": "INTEGER",
      "logica": "Retorna el ranking (1, 2, 3...) del usuario basado en total_xp DESC",
      "sql": "CREATE FUNCTION fn_get_user_position_in_leaderboard(p_user_id UUID) RETURNS INTEGER AS $$\nBEGIN\n  RETURN (SELECT COUNT(*) + 1 FROM users WHERE total_xp > (SELECT total_xp FROM users WHERE id = p_user_id));\nEND;\n$$ LANGUAGE plpgsql;"
    },
    {
      "id": "FN-004",
      "nombre": "fn_validate_sufficient_coins",
      "descripcion": "Función que valida si un usuario tiene suficientes monedas para una transacción",
      "epica_origen": "EAI-003",
      "user_story": "US-GAM-003, US-GAM-004",
      "prioridad": "P1",
      "parametros": [
        {"nombre": "p_user_id", "tipo": "UUID", "descripcion": "ID del usuario"},
        {"nombre": "p_required_coins", "tipo": "INTEGER", "descripcion": "Monedas requeridas"}
      ],
      "retorna": "BOOLEAN",
      "logica": "Retorna TRUE si user.total_coins >= p_required_coins, FALSE en caso contrario",
      "sql": "CREATE FUNCTION fn_validate_sufficient_coins(p_user_id UUID, p_required_coins INTEGER) RETURNS BOOLEAN AS $$\nBEGIN\n  RETURN (SELECT total_coins FROM users WHERE id = p_user_id) >= p_required_coins;\nEND;\n$$ LANGUAGE plpgsql;"
    }
  ],
  "triggers": [
    {
      "id": "TRG-001",
      "nombre": "trg_update_user_rank_on_xp_change",
      "descripcion": "Trigger que actualiza automáticamente el rango y nivel del usuario cuando su XP cambia. Se ejecuta después de INSERT/UPDATE en xp_transactions",
      "epica_origen": "EAI-003",
      "user_story": "US-GAM-001, US-GAM-002",
      "prioridad": "P0",
      "tabla": "xp_transactions",
      "evento": "AFTER INSERT",
      "nivel": "ROW",
      "logica": [
        "1. Obtener user.total_xp actualizado",
        "2. Calcular nuevo rango usando fn_calculate_rank_from_xp()",
        "3. Calcular nuevo nivel usando fn_calculate_level_from_xp()",
        "4. Comparar con valores actuales en users",
        "5. Si rango cambió: actualizar users y crear registro en rank_history",
        "6. Si solo nivel cambió: actualizar users"
      ],
      "pseudocodigo": "AFTER INSERT ON xp_transactions FOR EACH ROW BEGIN\n  SET @new_rank = fn_calculate_rank_from_xp(NEW.amount);\n  SET @new_level = fn_calculate_level_from_xp(NEW.amount);\n  SET @old_rank = (SELECT current_rank FROM users WHERE id = NEW.user_id);\n  SET @old_level = (SELECT level FROM users WHERE id = NEW.user_id);\n  \n  UPDATE users SET current_rank = @new_rank, level = @new_level WHERE id = NEW.user_id;\n  \n  IF @new_rank != @old_rank THEN\n    INSERT INTO rank_history (user_id, rank, achieved_at) VALUES (NEW.user_id, @new_rank, NOW());\n  END IF;\nEND;"
    },
    {
      "id": "TRG-002",
      "nombre": "trg_check_and_award_badges_on_activity_completion",
      "descripcion": "Trigger que verifica y otorga insignias automáticamente cuando se completa una actividad. Se ejecuta después de una transacción XP por activity_completed",
      "epica_origen": "EAI-003",
      "user_story": "US-GAM-005",
      "prioridad": "P1",
      "tabla": "xp_transactions",
      "evento": "AFTER INSERT",
      "nivel": "ROW",
      "condicion": "NEW.reason = 'activity_completed'",
      "logica": [
        "1. Verificar si es primera actividad del usuario",
        "2. Obtener total de XP actual",
        "3. Iterar sobre todas las insignias no ganadas",
        "4. Para cada insignia, verificar criterios usando logic específica",
        "5. Insertar en user_badges para las insignias desbloqueadas",
        "6. Otorgar rewards (XP, coins) de insignias desbloqueadas"
      ]
    },
    {
      "id": "TRG-003",
      "nombre": "trg_update_user_total_coins_on_transaction",
      "descripcion": "Trigger que actualiza automáticamente total_coins del usuario después de una transacción de monedas",
      "epica_origen": "EAI-003",
      "user_story": "US-GAM-003",
      "prioridad": "P0",
      "tabla": "coin_transactions",
      "evento": "AFTER INSERT",
      "nivel": "ROW",
      "logica": [
        "1. Obtener current total_coins del usuario",
        "2. Sumar amount (positivo o negativo)",
        "3. Validar que no sea negativo (CONSTRAINT)",
        "4. Actualizar users.total_coins",
        "5. Si amount es negativo y resulta insuficiente, ROLLBACK"
      ],
      "pseudocodigo": "AFTER INSERT ON coin_transactions FOR EACH ROW BEGIN\n  UPDATE users SET total_coins = total_coins + NEW.amount WHERE id = NEW.user_id;\n  \n  IF (SELECT total_coins FROM users WHERE id = NEW.user_id) < 0 THEN\n    SIGNAL SQLSTATE '45000' SET MESSAGE_TEXT = 'Insufficient coins';\n  END IF;\nEND;"
    }
  ],
